# CartPilot AI - Environment Variables
# Copy this file to .env and fill in your values

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# PayPal Sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Set to true if you want to test checkout without PayPal currency/regional blocks
SIMULATE_PAYPAL=true

# Seller Portal Credentials
SELLER_USERNAME=admin
SELLER_PASSWORD=cartpilot

BASE_URL=http://localhost:3000
PORT=3000
